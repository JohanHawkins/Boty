PORT=3000
NODE_ENV=development

# demo = respuestas simuladas sin API key | live = usa un LLM real
LLM_MODE=demo

# Solo necesarias en modo "live" (o con Ollama: LLM_API_URL=http://localhost:11434/v1/chat/completions)
LLM_API_KEY=tu_api_key_aqui
LLM_MODEL=gpt-4o-mini
LLM_API_URL=https://api.openai.com/v1/chat/completions
